# Copy to .env and fill in your values. Docker Compose reads it automatically.

# Required: the controller and the account the app uses. The account's role
# needs read-write admin privilege.
UNLEASHED_URL=https://unleashed.example.com
UNLEASHED_USERNAME=voucher-manager
UNLEASHED_PASSWORD=
# The guest WLAN that vouchers are created on.
UNLEASHED_SSID=Guest

# Recommended: the Wi-Fi details shown as a QR code and on printouts.
WIFI_SSID=Guest
WIFI_PASSWORD=
# WPA, WEP or nopass.
WIFI_TYPE=nopass
# WIFI_HIDDEN=false

# Recommended: the guest network, in IPv4 CIDR notation. Clients from it can
# only reach /welcome, so guests cannot manage vouchers.
GUEST_SUBNETWORK=192.0.2.0/24

# Optional (defaults shown)
# TIMEZONE=UTC
# UNLEASHED_HAS_VALID_CERT=true
# ROLLING_VOUCHER_DURATION_MINUTES=480
# PURGE_ALL_EXPIRED_VOUCHERS=false
# IS_LOGO_INVERTIBLE=true
# PRINT_CONFIG={"showName":true,"showLogo":true,"showDuration":true,"showMaxGuests":true,"showId":true,"showPrintTime":true}
# BACKEND_LOG_LEVEL=info
# FRONTEND_BIND_HOST=0.0.0.0
# FRONTEND_BIND_PORT=3000
# BACKEND_BIND_HOST=127.0.0.1
# BACKEND_BIND_PORT=8080
# FRONTEND_TO_BACKEND_URL=http://127.0.0.1
